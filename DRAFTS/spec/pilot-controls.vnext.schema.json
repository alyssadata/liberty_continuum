{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alyssadata/liberty_continuum/blob/main/DRAFTS/spec/pilot-controls.vnext.schema.json",
  "title": "Liberty Continuum vNext pilot-control registration (draft)",
  "description": "Control owner must specify metric definitions and thresholds before any pilot; values are local, justified, and reviewable.",
  "type": "object",
  "additionalProperties": false,
  "required": ["pilot_id", "jurisdiction", "service_id", "decision_classes", "accountable_authority", "independent_reviewer", "effective_from", "fallback_ref", "appeal_route", "thresholds"],
  "properties": {
    "pilot_id": {"type": "string", "minLength": 1},
    "jurisdiction": {"type": "string", "minLength": 1},
    "service_id": {"type": "string", "minLength": 1},
    "decision_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["C0", "C1", "C2", "C3", "C4"]}},
    "accountable_authority": {"type": "string", "minLength": 1},
    "independent_reviewer": {"type": "string", "minLength": 1},
    "effective_from": {"type": "string", "format": "date-time"},
    "effective_until": {"type": "string", "format": "date-time"},
    "fallback_ref": {"type": "string", "minLength": 1},
    "appeal_route": {"type": "string", "minLength": 1},
    "thresholds": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["metric", "method", "window", "warning_limit", "critical_limit", "responsible_role", "evidence_ref"], "properties": {
      "metric": {"type": "string", "minLength": 1}, "method": {"type": "string", "minLength": 1}, "window": {"type": "string", "minLength": 1}, "warning_limit": {"type": "number"}, "critical_limit": {"type": "number"}, "responsible_role": {"type": "string", "minLength": 1}, "evidence_ref": {"type": "string", "minLength": 1}
    }}}
  }
}